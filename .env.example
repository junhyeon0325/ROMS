# Supabase Database Connection URLs (Transaction Pooler & Direct URL for Prisma)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth.js Authentication Secret
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Naver Cloud Object Storage Credentials (S3 Compatible API)
NCP_OBJECT_STORAGE_ACCESS_KEY="your-ncp-access-key"
NCP_OBJECT_STORAGE_SECRET_KEY="your-ncp-secret-key"
NCP_OBJECT_STORAGE_ENDPOINT="https://kr.object.ncloudstorage.com"
NCP_OBJECT_STORAGE_BUCKET="roms-storage"
