datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  DEV
}

enum Position {
  TANK
  DAMAGE
  HEALER
}

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String?
  role         Role     @default(USER)

  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedBy    String?  @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")
  remarks      String?  @map("remarks")

  @@map("users")
}

model Season {
  id        BigInt    @id @default(autoincrement())
  name      String
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  status    String    @default("개최 예정")
  prize     String    @default("")
  prizeAmount Decimal? @map("prize_amount") @db.Decimal(18, 0)

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedBy String?   @map("updated_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  remarks   String?   @map("remarks")

  seasonTeams SeasonTeam[]
  matches     Match[]
  schedules   SeasonSchedule[]
  rankPrizes  SeasonRankPrize[]
  participants SeasonParticipant[]

  @@map("seasons")
}

model SeasonSchedule {
  id           BigInt   @id @default(autoincrement())
  seasonId     BigInt   @map("season_id")
  name         String
  startAt      DateTime? @map("start_at")
  endAt        DateTime? @map("end_at")
  sortOrder    Int      @map("sort_order")
  season       Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId, sortOrder])
  @@map("season_schedules")
}

model SeasonRankPrize {
  id           BigInt   @id @default(autoincrement())
  seasonId     BigInt   @map("season_id")
  rank         Int
  amount       Decimal  @db.Decimal(18, 0)
  season       Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, rank])
  @@map("season_rank_prizes")
}

model Team {
  id        BigInt  @id @default(autoincrement())
  name      String
  emblemUrl String? @map("emblem_url")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  seasonTeams SeasonTeam[]
  heroBans    HeroBan[]

  @@map("teams")
}

model Streamer {
  id              BigInt   @id @default(autoincrement())
  name            String
  profileImageUrl String?  @map("profile_image_url")
  chzzkChannelId  String?  @unique @map("chzzk_channel_id")
  isUse           Boolean  @default(true) @map("is_use")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  teamMembers    SeasonTeamMember[]
  seasonParticipants SeasonParticipant[]
  playerSetStats PlayerSetStat[]

  @@index([name])
  @@index([createdAt(sort: Desc)])
  @@map("streamers")
}

model SeasonTeam {
  id       BigInt @id @default(autoincrement())
  seasonId BigInt @map("season_id")
  teamId   BigInt @map("team_id")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  members SeasonTeamMember[]

  @@map("season_teams")
}

model SeasonTeamMember {
  id           BigInt   @id @default(autoincrement())
  seasonTeamId BigInt   @map("season_team_id")
  streamerId   BigInt   @map("streamer_id")
  position     Position

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  seasonTeam SeasonTeam @relation(fields: [seasonTeamId], references: [id], onDelete: Cascade)
  streamer   Streamer   @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("season_team_members")
}

model SeasonParticipant {
  id         BigInt   @id @default(autoincrement())
  seasonId   BigInt   @map("season_id")
  streamerId BigInt   @map("streamer_id")
  roles      String[]
  position   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  season   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Restrict)

  @@unique([seasonId, streamerId])
  @@map("season_participants")
}

model Match {
  id              BigInt    @id @default(autoincrement())
  seasonId        BigInt    @map("season_id")
  tournamentStage String    @map("tournament_stage")
  matchDate       DateTime? @map("match_date")
  teamAId         BigInt    @map("team_a_id")
  teamBId         BigInt    @map("team_b_id")
  winnerTeamId    BigInt?   @map("winner_team_id")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  season Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  sets   MatchSet[]

  @@map("matches")
}

model MapItem {
  id          BigInt  @id @default(autoincrement())
  name        String
  nameEn      String? @map("name_en")
  mapType     String  @map("map_type")
  location    String?
  countryCode String? @map("country_code")
  imageUrl    String? @map("image_url")
  isActive    Boolean @default(false) @map("is_active")
  source      String  @default("MANUAL")
  sourceKey   String? @unique @map("source_key")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  matchSets MatchSet[]

  @@map("maps")
}

model MatchSet {
  id                  BigInt  @id @default(autoincrement())
  matchId             BigInt  @map("match_id")
  setNumber           Int     @map("set_number")
  mapId               BigInt  @map("map_id")
  winnerTeamId        BigInt  @map("winner_team_id")
  gameDurationSeconds Int?    @map("game_duration_seconds")
  vodUrl              String? @map("vod_url")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  match Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  map   MapItem @relation(fields: [mapId], references: [id], onDelete: Cascade)

  playerStats PlayerSetStat[]
  heroBans    HeroBan[]

  @@map("match_sets")
}

model PlayerSetStat {
  id              BigInt  @id @default(autoincrement())
  matchSetId      BigInt  @map("match_set_id")
  streamerId      BigInt  @map("streamer_id")
  kills           Int     @default(0)
  deaths          Int     @default(0)
  assists         Int     @default(0)
  damage          Int     @default(0)
  healing         Int     @default(0)
  mitigatedDamage Int     @default(0) @map("mitigated_damage")
  mainHeroIds     String? @map("main_hero_ids")
  isMvp           Boolean @default(false) @map("is_mvp")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  matchSet MatchSet @relation(fields: [matchSetId], references: [id], onDelete: Cascade)
  streamer Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@map("player_set_stats")
}

model Hero {
  id         BigInt  @id @default(autoincrement())
  name       String
  nameEn     String  @unique @map("name_en")
  role       String
  isPickable Boolean @default(true) @map("is_pickable")
  imageUrl   String? @map("image_url")
  source     String  @default("MANUAL")
  sourceKey  String? @unique @map("source_key")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  heroBans HeroBan[]

  @@index([role])
  @@index([isPickable])
  @@map("heroes")
}

model HeroBan {
  id         BigInt @id @default(autoincrement())
  matchSetId BigInt @map("match_set_id")
  teamId     BigInt @map("team_id")
  heroId     BigInt @map("hero_id")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  matchSet MatchSet @relation(fields: [matchSetId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hero     Hero     @relation(fields: [heroId], references: [id], onDelete: Restrict)

  @@map("hero_bans")
}

model CommonCodeGroup {
  id          BigInt   @id @default(autoincrement())
  groupCode   String   @unique @map("group_code")
  groupName   String   @map("group_name")
  sortOrder   Int      @default(0) @map("sort_order")
  isUse       Boolean  @default(true) @map("is_use")

  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  remarks     String?  @map("remarks")

  codes CommonCode[]

  @@map("common_code_groups")
}

model CommonCode {
  id        BigInt  @id @default(autoincrement())
  groupCode String  @map("group_code")
  code      String
  codeName  String  @map("code_name")
  sortOrder Int     @default(0) @map("sort_order")
  isUse     Boolean @default(true) @map("is_use")

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")
  remarks   String?  @map("remarks")

  group CommonCodeGroup @relation(fields: [groupCode], references: [groupCode], onDelete: Cascade)

  @@unique([groupCode, code])
  @@map("common_codes")
}
