# Naver Cloud Platform (NCP) Database Connection URL (PostgreSQL / MySQL)
DATABASE_URL="postgresql://ncp_user:ncp_password@ncp-db-host:5432/roms_db?schema=public"

# NextAuth.js Authentication Secret
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Naver Cloud Object Storage Credentials (S3 Compatible API)
NCP_OBJECT_STORAGE_ACCESS_KEY="your-ncp-access-key"
NCP_OBJECT_STORAGE_SECRET_KEY="your-ncp-secret-key"
NCP_OBJECT_STORAGE_ENDPOINT="https://kr.object.ncloudstorage.com"
NCP_OBJECT_STORAGE_BUCKET="roms-storage"
